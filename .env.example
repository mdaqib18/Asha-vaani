# Domain used by Caddy for automatic Let's Encrypt HTTPS (e.g. ashavaani.duckdns.org)
DOMAIN=your-subdomain.duckdns.org

# Speech-to-Text & Text-to-Speech (Gnani Vachana)
GNANI_API_KEY=replace-with-your-gnani-api-key
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_STREAM_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Lakshmi
GNANI_TIMEOUT_S=30.0

# LLM Extraction
LLM_PROVIDER=gemini
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=30.0

# Persistence (SQLite stored on mounted ./data:/app/data volume)
DATABASE_URL=sqlite:///./data/ashavaani.db

# Clinical workflow & retention
MAX_FOLLOWUPS=2
AUDIO_RETENTION_DAYS=7

# Session & auth (generate a long random value on the server, e.g. openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=120
REQUIRE_AUTH=false

# Seed labeled synthetic demo data on first startup when database has no beneficiaries
SEED_DEMO_DATA=true
